# Safe public configuration. Use a modern sb_publishable_ key, never a
# service_role or sb_secret_ key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical production origin used for Auth redirect URLs and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
